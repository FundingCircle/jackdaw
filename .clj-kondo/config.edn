{:linters {:unused-binding { ;; ignore unused :as binding.
                            :exclude-destructured-as true}
           :unresolved-symbol { ;; `thrown-with-msg-and-data?` is a legit extension to the `is` macro
                               ;; via an `assert-expr` defmethod (see clojure.test doc)
                               :exclude [(clojure.test/is [thrown-with-msg-and-data?])]}
           ;; clj-uuid defines its vars (v4, v5, +null+, to-string, ...) via
           ;; macros that clj-kondo can't analyse; treat them as resolved.
           :unresolved-var {:exclude [clj-uuid]}
           ;; jackdaw.test.commands intentionally excludes the `do` special form
           ;; so it can define its own `do` command builder.
           :unresolved-excluded-var {:level :off}}

 :lint-as {clojure.test.check.clojure-test/defspec clojure.core/def
           jackdaw.data/defn->data clojure.core/defn
           manifold.deferred/loop clojure.core/let}

 :hooks {:analyze-call {jackdaw.test.transports/deftransport
                        hooks.jackdaw.test.transports/deftransport}}}