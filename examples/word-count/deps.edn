{:paths
 ["src" "resources"]

 :deps
 {fundingcircle/jackdaw {:local/root "../.."}
  org.clojure/clojure {:mvn/version "1.12.5"}
  org.clojure/tools.logging {:mvn/version "0.4.1"}
  org.apache.kafka/kafka-clients {:mvn/version "4.3.1"}
  org.apache.kafka/kafka-streams {:mvn/version "4.3.1"}
  org.apache.kafka/kafka-streams-test-utils {:mvn/version "4.3.1"}
  ch.qos.logback/logback-classic {:mvn/version "1.2.3"}
  integrant {:mvn/version "0.7.0"}}

 :aliases
 {:dev
  {:extra-paths ["dev" "../../dev"]
   :extra-deps {integrant/repl {:mvn/version "0.3.1"}
                danlentz/clj-uuid {:mvn/version "0.1.7"
                                   :exclusions [primitive-math]}}}

  :test
  {:extra-paths ["test"]
   :extra-deps {com.cognitect/test-runner {:git/url "https://github.com/cognitect-labs/test-runner.git"
                                           :sha "028a6d41ac9ac5d5c405dfc38e4da6b4cc1255d5"}
                ;; jackdaw's test-machine (rest-proxy transport) needs aleph,
                ;; which is a dev-only dep of jackdaw and not pulled via :local/root.
                aleph/aleph {:mvn/version "0.9.11"}}
   :main-opts ["-m" "test-runner"]}}

 :mvn/repos
 {"confluent" {:url "https://packages.confluent.io/maven/"}}}
